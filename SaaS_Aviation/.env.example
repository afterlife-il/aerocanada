# Local development only. Do not commit real secrets.
NODE_ENV=development
WEB_PORT=3007
API_PORT=4107

# Legacy Yoyamic database adapter. Optional for local scaffolding.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_NAME=aerocanada_yoyamic
LEGACY_DB_USER=readonly_user
LEGACY_DB_PASSWORD=replace_locally

# Auth provider bridge placeholder.
AUTH_PROVIDER=mock
AUTH_SESSION_SECRET=replace_with_local_random_value
