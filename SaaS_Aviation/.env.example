# Local development only. Do not commit real secrets.
NODE_ENV=development
WEB_PORT=3007
API_PORT=4107

# SaaS persistence provider. Use memory for default local unit tests.
# Use postgres only with a local development/test database.
PERSISTENCE_PROVIDER=memory
DATA_SOURCE_MODE=memory
DATABASE_URL=postgresql://saas_aviation_dev:replace_locally@127.0.0.1:5432/saas_aviation_dev
TEST_DATABASE_URL=postgresql://saas_aviation_test:replace_locally@127.0.0.1:5432/saas_aviation_test
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Local persistent frontend mode. Public static export must remain sample-static.
NEXT_PUBLIC_SAAS_DATA_SOURCE_MODE=sample-static
NEXT_PUBLIC_SAAS_API_BASE_URL=http://127.0.0.1:4107

# Legacy Yoyamic database adapter. Optional for local scaffolding.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_NAME=aerocanada_yoyamic
LEGACY_DB_USER=readonly_user
LEGACY_DB_PASSWORD=replace_locally

# Auth provider bridge placeholder.
AUTH_PROVIDER=mock
AUTH_SESSION_SECRET=replace_with_local_random_value
