{
  "name": "@saas-aviation/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --loader ts-node/esm src/server.test.ts src/postgres-persistence.test.ts src/importers/yoyamic-live-audit.test.ts",
    "migrate:status": "tsx src/persistence/migrations.ts status",
    "migrate:apply": "tsx src/persistence/migrations.ts apply",
    "seed:staging": "tsx src/persistence/seed-staging.ts",
    "import:yoyamic:audit": "tsx src/importers/yoyamic-live-audit.ts",
    "import:yoyamic:sample": "tsx src/importers/yoyamic-sample-import.ts"
  },
  "dependencies": {
    "@saas-aviation/shared": "0.1.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mysql2": "^3.23.0",
    "pg": "^8.22.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.20.0",
    "eslint": "^9.30.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  }
}
