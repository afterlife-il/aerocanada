// Fonction mysql2_query mise à jour
function mysql2_query($sql) {
    global $db_link, $debug_mode;

    // Vérifier si la requête est vide
    if (empty($sql)) {
        if ($debug_mode) {
            die("Erreur : La requête SQL est vide.");
        } else {
            die("Erreur : Impossible d'exécuter la requête.");
        }
    }

    // Afficher la requête pour débogage uniquement si debug_mode est activé
    if ($debug_mode) {
        echo "Requête SQL exécutée : " . htmlspecialchars($sql) . "<br>";
    }

    // Exécuter la requête
    $result = mysqli_query($db_link, $sql);

    // Si la requête échoue, afficher l'erreur et la requête si debug_mode est activé
    if (!$result) {
        if ($debug_mode) {
            die("Erreur SQL : " . mysqli_error($db_link) . " dans la requête : " . htmlspecialchars($sql));
        } else {
            die("Erreur SQL : Une erreur s'est produite.");
        }
    }
    return $result;
}

// Fonction d'échappement des données
function escape_data($data) {
    global $db_link;
    return mysqli_real_escape_string($db_link, $data);
}

function mysql2_insert_id() {
    global $db_link;
